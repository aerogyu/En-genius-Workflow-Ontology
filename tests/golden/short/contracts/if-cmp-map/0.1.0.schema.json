{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://en-genius.local/schema/if-cmp-map/0.1.0.json",
  "title": "압축기 특성 맵 0.1.0",
  "x-interface": {
    "key": "if-cmp-map",
    "version": "0.1.0",
    "iri": "http://en-genius.local/id/IFC-000001"
  },
  "type": "object",
  "required": [
    "contract",
    "version",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "if-cmp-map"
    },
    "version": {
      "const": "0.1.0"
    },
    "produced_by": {
      "type": "string",
      "description": "만든 단계 key"
    },
    "case": {
      "type": "string",
      "description": "사례 이름 (자유)"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "description": "루프 반복 회차 — 0 = 첫 바퀴 가정값(Loop.initial)"
    },
    "data": {
      "$ref": "#/$defs/_data"
    }
  },
  "$defs": {
    "_data": {
      "type": "object",
      "title": "압축기 특성 맵",
      "properties": {
        "map_file": {
          "title": "맵 파일 (속도선별 수정유량·압력비·효율)",
          "type": "string",
          "pattern": "\\.([cC][sS][vV])$"
        },
        "surge_margin": {
          "title": "설계점 서지 마진",
          "x-unit": "%",
          "x-qudt-unit": "http://qudt.org/vocab/unit/PERCENT",
          "description": "[%]",
          "type": "number"
        },
        "map_source": {
          "title": "맵 출처",
          "type": "string",
          "enum": [
            "1D 상관식",
            "3D CFD",
            "시험"
          ]
        }
      },
      "required": [
        "map_file",
        "surge_margin",
        "map_source"
      ],
      "additionalProperties": false
    }
  }
}
