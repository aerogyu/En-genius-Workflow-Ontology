    },
    {
     "name": "n_cells",
     "type": "integer",
     "unit": "1",
     "label": "격자 수"
    }
   ],
   "discipline": "cmp"
  },
  {
   "key": "if-cmp-cfd-summary",
   "label": "압축기 3D 유동 확인 요약",
