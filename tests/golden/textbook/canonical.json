     "label": "설계점 고도"
    },
    {
     "name": "Mach",
     "type": "number",
     "unit": "1",
     "label": "설계점 비행 마하수"
    }
   ],
   "discipline": "perf"
  },
  {
   "key": "if-cycle-dp",
   "label": "설계점 사이클 결과",
   "version": "0.1.0",
   "records": [
    {
     "name": "Station",
     "label": "스테이션 상태",
     "items": [
      {
       "name": "station",
