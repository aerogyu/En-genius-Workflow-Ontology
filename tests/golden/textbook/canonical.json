     "label": "스테이션 표"
    }
   ],
   "discipline": "perf"
  },
  {
   "key": "if-perf-od",
   "label": "탈설계점 작동점",
   "version": "0.1.0",
   "items": [
    {
     "name": "N_rel",
     "type": "number",
     "unit": "%",
     "label": "상대 회전수"
    },
    {
     "name": "W2R",
     "type": "number",
     "unit": "kg/s",
     "label": "압축기 입구 수정 유량"
    },
    {
     "name": "PR_c",
     "type": "number",
     "unit": "1",
     "label": "압축기 압력비"
    },
    {
     "name": "mismatch",
     "type": "number",
     "unit": "%",
     "label": "설계점 대비 작동점 차이"
    }
   ],
   "discipline": "perf"
  }
 ],
 "loops": [
  {
   "key": "loop-cmp-match",
   "label": "압축기–사이클 매칭 루프",
   "back_from": "perf-offdesign",
   "back_to": "cmp-meanline",
   "until": "작동점 차이 mismatch 1 % 이내이고 서지 마진 15 % 이상 (예시 값, 판정은 엔지니어)",
   "initial": "첫 바퀴는 탈설계 결과 없이 설계점 값만으로 (mismatch 0 가정)",
   "monitor": [
    "if-perf-od.mismatch",
    "if-cmp-map.surge_margin"
   ],
   "max_iterations": 5
  }
 ]
}
