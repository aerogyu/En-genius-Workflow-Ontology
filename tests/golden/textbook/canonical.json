   "deliverable": true,
   "items": [
    {
     "name": "eta_is_cfd",
     "type": "number",
     "unit": "1",
     "label": "CFD 효율"
    },
    {
     "name": "report",
     "type": "file",
     "formats": [
      "pdf",
      "docx"
     ],
     "label": "보고서"
    }
   ],
   "discipline": "cmp"
  },
  {
   "key": "if-engine-reqs",
