      "시험"
     ],
     "label": "맵 출처",
     "name": "map_source"
    }
   ],
   "discipline": "cmp"
  },
  {
   "key": "if-cmp-mesh",
   "label": "압축기 유로 메시",
   "version": "0.1.0",
   "items": [
    {
     "name": "mesh_file",
     "type": "file",
     "formats": [
      "cgns"
     ],
