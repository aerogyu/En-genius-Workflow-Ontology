   "label_at_link": "AxSTREAM"
  },
  {
   "key": "excel",
   "label": "Excel",
   "tool_id": "TOOL-000002",
   "label_at_link": "Excel"
  },
  {
   "key": "turbogrid",
   "label": "ANSYS TurboGrid"
  },
  {
   "key": "cfx",
   "label": "ANSYS CFX"
  },
  {
   "key": "meanline-py",
   "label": "평균반경 설계 스크립트 (가상)",
   "not_in_survey": "개인 스크립트라 조사 대상 아님"
  }
 ],
 "steps": [
  {
   "key": "cmp-meanline",
   "label": "압축기 1D 평균반경 설계 (단수·속도삼각형)",
   "tools": [
    "meanline-py",
    "excel"
   ],
   "components": [
    "hpc"
   ],
   "inputs": [
    {
     "interface": "if-cycle-dp",
     "transfer": "메일·수기 전달",
     "tool": "excel"
    },
    {
     "interface": "if-perf-od",
     "transfer": "메일·수기 전달",
     "tool": "excel"
    }
   ],
   "outputs": [
    {
     "interface": "if-cmp-1d",
     "tool": "meanline-py",
     "format": "csv"
    }
   ],
   "discipline": "cmp"
  },
  {
   "key": "cmp-map",
   "label": "압축기 특성 맵 생성",
   "tools": [
    "axstream"
   ],
   "components": [
    "hpc"
   ],
   "inputs": [
    {
     "interface": "if-cmp-1d",
     "transfer": "파일 저장",
     "format": "csv"
    }
   ],
   "outputs": [
    {
     "interface": "if-cmp-map"
    }
   ],
   "discipline": "cmp"
  },
  {
   "key": "cmp-cfd-check",
   "label": "압축기 3D 유동 확인 (설계점)",
   "components": [
    "hpc"
   ],
   "inputs": [
    {
     "interface": "if-cmp-1d"
    }
   ],
   "outputs": [
    {
     "interface": "if-cmp-cfd-summary"
    }
   ],
   "discipline": "cmp"
  },
  {
   "key": "cmp-cfd-mesh",
   "label": "압축기 유로 메시 생성",
   "part_of": "cmp-cfd-check",
   "tools": [
    "turbogrid"
   ],
   "inputs": [
    {
     "interface": "if-cmp-1d"
    }
   ],
   "outputs": [
    {
     "interface": "if-cmp-mesh"
    }
   ],
   "discipline": "cmp"
  },
  {
   "key": "cmp-cfd-solve",
   "label": "압축기 3D 정상 유동 해석",
   "part_of": "cmp-cfd-check",
   "tools": [
    "cfx"
   ],
   "inputs": [
    {
     "interface": "if-cmp-mesh"
    }
   ],
   "outputs": [
    {
     "interface": "if-cmp-cfd-summary"
    }
   ],
   "discipline": "cmp"
  },
  {
   "key": "perf-cycle-dp",
   "label": "설계점 사이클 해석",
   "tools": [
    "gasturb"
   ],
   "inputs": [
    {
     "interface": "if-engine-reqs"
    }
   ],
   "outputs": [
    {
     "interface": "if-cycle-dp"
    }
   ],
   "discipline": "perf"
  },
  {
   "key": "perf-offdesign",
   "label": "탈설계점 성능 해석 (부품 맵 매칭)",
   "tools": [
    "gasturb"
   ],
   "inputs": [
    {
     "interface": "if-cycle-dp"
    },
    {
     "interface": "if-cmp-map",
     "transfer": "파일 저장",
     "format": "csv"
    }
   ],
   "outputs": [
    {
     "interface": "if-perf-od"
    }
   ],
   "discipline": "perf"
  }
 ],
 "interfaces": [
  {
   "key": "if-cmp-1d",
   "label": "압축기 1D 설계 결과",
   "version": "0.1.0",
   "items": [
    {
     "name": "n_stages",
     "type": "integer",
     "unit": "1",
     "label": "단수"
    },
    {
     "name": "PR_c",
     "type": "number",
     "unit": "1",
     "label": "설계 압력비"
    },
    {
     "unit": "1",
     "label": "등엔트로피 효율",
     "minimum": 0.0,
     "maximum": 1.0,
     "name": "eta_is",
     "type": "number"
    },
    {
     "name": "N_mech",
     "type": "number",
     "unit": "rpm",
     "label": "기계 회전수"
    },
    {
     "name": "flowpath",
     "type": "file",
     "formats": [
      "csv"
     ],
     "label": "유로 형상 (자오면 좌표)"
    }
   ],
   "discipline": "cmp"
  },
  {
   "key": "if-cmp-map",
   "label": "압축기 특성 맵",
   "version": "0.1.0",
   "records": [
    {
     "name": "MapPoint",
     "label": "맵 한 점",
     "items": [
      {
       "name": "W_corr",
       "type": "number",
       "unit": "kg/s",
       "label": "수정 유량"
      },
      {
       "name": "PR",
       "type": "number",
       "unit": "1",
       "label": "압력비"
      },
      {
       "unit": "1",
       "label": "단열효율",
       "minimum": 0.0,
       "maximum": 1.0,
       "name": "eta",
       "type": "number"
      }
     ]
    },
    {
     "name": "SpeedLine",
     "label": "속도선",
     "items": [
      {
       "name": "N_rel",
       "type": "number",
       "unit": "%",
       "label": "상대 수정 회전수"
      },
      {
       "type": "struct",
       "ref": "MapPoint",
       "list": true,
       "min_items": 3,
       "label": "맵 점",
       "name": "points"
      }
     ]
    }
   ],
   "items": [
    {
     "type": "struct",
     "ref": "SpeedLine",
     "list": true,
     "min_items": 2,
     "label": "속도선",
     "name": "speed_lines"
    },
    {
     "name": "surge_margin",
     "type": "number",
     "unit": "%",
     "label": "설계점 서지 마진"
    },
    {
