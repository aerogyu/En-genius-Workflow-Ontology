{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://en-genius.local/schema/if-cmp-cfd-summary/0.1.0.json",
  "title": "압축기 3D 유동 확인 요약 0.1.0",
  "x-interface": {
    "key": "if-cmp-cfd-summary",
    "version": "0.1.0",
    "iri": "http://en-genius.local/id/IFC-000004"
  },
  "type": "object",
  "required": [
    "contract",
    "version",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "if-cmp-cfd-summary"
    },
    "version": {
      "const": "0.1.0"
    },
    "produced_by": {
      "type": "string",
      "description": "만든 단계 key"
    },
    "case": {
      "type": "string",
      "description": "사례 이름 (자유)"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "description": "루프 반복 회차 — 0 = 첫 바퀴 가정값(Loop.initial)"
    },
    "data": {
      "$ref": "#/$defs/_data"
    }
  },
  "$defs": {
    "_data": {
      "type": "object",
      "title": "압축기 3D 유동 확인 요약",
      "properties": {
        "eta_is_cfd": {
          "title": "CFD 효율",
          "x-unit": "1",
          "x-qudt-unit": "http://qudt.org/vocab/unit/UNITLESS",
          "description": "[1]",
          "type": "number"
        },
        "report": {
          "title": "보고서",
          "type": "string",
          "pattern": "\\.([pP][dD][fF]|[dD][oO][cC][xX])$"
        }
      },
      "required": [
        "eta_is_cfd",
        "report"
      ],
      "additionalProperties": false
    }
  }
}
