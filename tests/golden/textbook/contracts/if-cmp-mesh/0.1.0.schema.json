{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://en-genius.local/schema/if-cmp-mesh/0.1.0.json",
  "title": "압축기 유로 메시 0.1.0",
  "x-interface": {
    "key": "if-cmp-mesh",
    "version": "0.1.0",
    "iri": "http://en-genius.local/id/IFC-000003"
  },
  "type": "object",
  "required": [
    "contract",
    "version",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "if-cmp-mesh"
    },
    "version": {
      "const": "0.1.0"
    },
    "produced_by": {
      "type": "string",
      "description": "만든 단계 key"
    },
    "case": {
      "type": "string",
      "description": "사례 이름 (자유)"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "description": "루프 반복 회차 — 0 = 첫 바퀴 가정값(Loop.initial)"
    },
    "data": {
      "$ref": "#/$defs/_data"
    }
  },
  "$defs": {
    "_data": {
      "type": "object",
      "title": "압축기 유로 메시",
      "properties": {
        "mesh_file": {
          "title": "메시 파일",
          "type": "string",
          "pattern": "\\.([cC][gG][nN][sS])$"
        },
        "n_cells": {
          "title": "격자 수",
          "x-unit": "1",
          "x-qudt-unit": "http://qudt.org/vocab/unit/UNITLESS",
          "description": "[1]",
          "type": "integer"
        }
      },
      "required": [
        "mesh_file",
        "n_cells"
      ],
      "additionalProperties": false
    }
  }
}
