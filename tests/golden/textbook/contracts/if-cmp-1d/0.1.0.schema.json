{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://en-genius.local/schema/if-cmp-1d/0.1.0.json",
  "title": "압축기 1D 설계 결과 0.1.0",
  "x-interface": {
    "key": "if-cmp-1d",
    "version": "0.1.0",
    "iri": "http://en-genius.local/id/IFC-000001"
  },
  "type": "object",
  "required": [
    "contract",
    "version",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "if-cmp-1d"
    },
    "version": {
      "const": "0.1.0"
    },
    "produced_by": {
      "type": "string",
      "description": "만든 단계 key"
    },
    "case": {
      "type": "string",
      "description": "사례 이름 (자유)"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "description": "루프 반복 회차 — 0 = 첫 바퀴 가정값(Loop.initial)"
    },
    "data": {
      "$ref": "#/$defs/_data"
    }
  },
  "$defs": {
    "_data": {
      "type": "object",
      "title": "압축기 1D 설계 결과",
      "properties": {
        "n_stages": {
          "title": "단수",
          "x-unit": "1",
          "x-qudt-unit": "http://qudt.org/vocab/unit/UNITLESS",
          "description": "[1]",
          "type": "integer"
        },
        "PR_c": {
          "title": "설계 압력비",
          "x-unit": "1",
          "x-qudt-unit": "http://qudt.org/vocab/unit/UNITLESS",
          "description": "[1]",
          "type": "number"
        },
        "eta_is": {
          "title": "등엔트로피 효율",
          "x-unit": "1",
          "x-qudt-unit": "http://qudt.org/vocab/unit/UNITLESS",
          "description": "[1]",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "N_mech": {
          "title": "기계 회전수",
          "x-unit": "rpm",
          "x-qudt-unit": "http://qudt.org/vocab/unit/REV-PER-MIN",
          "description": "[rpm]",
          "type": "number"
        },
        "flowpath": {
          "title": "유로 형상 (자오면 좌표)",
          "type": "string",
          "pattern": "\\.([cC][sS][vV])$"
        }
      },
      "required": [
        "n_stages",
        "PR_c",
        "eta_is",
        "N_mech",
        "flowpath"
      ],
      "additionalProperties": false
    }
  }
}
